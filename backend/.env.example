# Entorno
NODE_ENV=production
PORT=3001

# Frontend URL (URL de tu frontend en Vercel)
FRONTEND_URL=https://tu-frontend.vercel.app

# MongoDB Atlas
# Copia tu URI completa de MongoDB Atlas aquí
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=cambia-este-secret-por-uno-seguro-minimo-32-caracteres
JWT_EXPIRES_IN=7d

# WebAuthn Configuration
WEBAUTHN_RP_NAME=Salud Para Salta y NOA
WEBAUTHN_RP_ID=tu-dominio.com
WEBAUTHN_ORIGIN=https://tu-frontend.vercel.app

# ML Service URL (URL del predictor en Railway)
ML_SERVICE_URL=https://tu-ml-service.railway.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
